---
const title = 'Websites for Local Businesses in Palm Beach County, FL | Lambertt Tech';
const description =
  'Custom websites for local businesses across Palm Beach County, FL. Based in Jupiter, serving Jupiter, Palm Beach Gardens, Tequesta, Wellington and beyond. Free mockup included.';
const url = 'https://lambertttech.com/';
const ogImage = 'https://lambertttech.com/og-image.png?v=2';
---

<meta charset='UTF-8' />
<meta
  name='viewport'
  content='width=device-width, initial-scale=1.0'
/>
<title>{title}</title>
<meta
  name='description'
  content={description}
/>
<link
  rel='canonical'
  href={url}
/>
<meta
  name='robots'
  content='index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'
/>
<meta
  name='theme-color'
  content='#0F6BAE'
/>
<link
  rel='manifest'
  href='/manifest.json'
/>
<link
  rel='icon'
  type='image/svg+xml'
  href='/favicon.svg'
/>
<link
  rel='icon'
  type='image/png'
  sizes='32x32'
  href='/favicon-32.png'
/>
<link
  rel='apple-touch-icon'
  sizes='180x180'
  href='/apple-touch-icon.png'
/>
<!-- Open Graph -->
<meta
  property='og:type'
  content='website'
/>
<meta
  property='og:site_name'
  content='Lambertt Tech LLC'
/>
<meta
  property='og:locale'
  content='en_US'
/>
<meta
  property='og:url'
  content={url}
/>
<meta
  property='og:title'
  content={title}
/>
<meta
  property='og:description'
  content={description}
/>
<meta
  property='og:image'
  content={ogImage}
/>
<meta
  property='og:image:secure_url'
  content={ogImage}
/>
<meta
  property='og:image:type'
  content='image/png'
/>
<meta
  property='og:image:width'
  content='1200'
/>
<meta
  property='og:image:height'
  content='630'
/>
<meta
  property='og:image:alt'
  content='Lambertt Tech — Websites for local businesses in Palm Beach County, FL'
/>
<!-- Twitter Card -->
<meta
  name='twitter:card'
  content='summary_large_image'
/>
<meta
  name='twitter:url'
  content={url}
/>
<meta
  name='twitter:domain'
  content='lambertttech.com'
/>
<meta
  name='twitter:title'
  content={title}
/>
<meta
  name='twitter:description'
  content='Custom websites for local businesses across Palm Beach County, FL. Based in Jupiter. Free mockup included.'
/>
<meta
  name='twitter:image'
  content={ogImage}
/>
<meta
  name='twitter:image:alt'
  content='Lambertt Tech — Websites for local businesses in Palm Beach County, FL'
/>
<!-- Geo targeting -->
<meta
  name='geo.region'
  content='US-FL'
/>
<meta
  name='geo.placename'
  content='Jupiter, Florida'
/>
<meta
  name='geo.position'
  content='26.9342;-80.0942'
/>
<meta
  name='ICBM'
  content='26.9342, -80.0942'
/>
