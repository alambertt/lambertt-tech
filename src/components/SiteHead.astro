---
const title = 'Custom Software Development & Cloud Engineering | Lambertt Tech';
const description =
  'We design and build software that holds up at scale — custom platforms, cloud infrastructure, AI agents, and system integrations for companies from growth stage to enterprise.';
const url = 'https://lambertttech.com/';
const ogImage = 'https://lambertttech.com/og-image.png?v=2';
---

<meta charset='UTF-8' />
<meta
  name='viewport'
  content='width=device-width, initial-scale=1.0'
/>
<title>{title}</title>
<meta
  name='description'
  content={description}
/>
<link
  rel='canonical'
  href={url}
/>
<meta
  name='robots'
  content='index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'
/>
<meta
  name='theme-color'
  content='#0F6BAE'
/>
<link
  rel='manifest'
  href='/manifest.json'
/>
<link
  rel='icon'
  type='image/svg+xml'
  href='/favicon.svg'
/>
<link
  rel='icon'
  type='image/png'
  sizes='32x32'
  href='/favicon-32.png'
/>
<link
  rel='apple-touch-icon'
  sizes='180x180'
  href='/apple-touch-icon.png'
/>
<!-- Open Graph -->
<meta
  property='og:type'
  content='website'
/>
<meta
  property='og:site_name'
  content='Lambertt Tech LLC'
/>
<meta
  property='og:locale'
  content='en_US'
/>
<meta
  property='og:url'
  content={url}
/>
<meta
  property='og:title'
  content={title}
/>
<meta
  property='og:description'
  content={description}
/>
<meta
  property='og:image'
  content={ogImage}
/>
<meta
  property='og:image:secure_url'
  content={ogImage}
/>
<meta
  property='og:image:type'
  content='image/png'
/>
<meta
  property='og:image:width'
  content='1200'
/>
<meta
  property='og:image:height'
  content='630'
/>
<meta
  property='og:image:alt'
  content='Lambertt Tech — custom software, cloud infrastructure, and system integration'
/>
<!-- Twitter Card -->
<meta
  name='twitter:card'
  content='summary_large_image'
/>
<meta
  name='twitter:url'
  content={url}
/>
<meta
  name='twitter:domain'
  content='lambertttech.com'
/>
<meta
  name='twitter:title'
  content={title}
/>
<meta
  name='twitter:description'
  content='Custom platforms, cloud infrastructure, AI agents, and system integrations for companies from growth stage to enterprise.'
/>
<meta
  name='twitter:image'
  content={ogImage}
/>
<meta
  name='twitter:image:alt'
  content='Lambertt Tech — custom software, cloud infrastructure, and system integration'
/>
<!-- Structured Data -->
<script type='application/ld+json' is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": "https://lambertttech.com/#business",
        "name": "Lambertt Tech LLC",
        "url": "https://lambertttech.com/",
        "telephone": "+15617814836",
        "email": "angel@lambertt.tech",
        "description": "Software engineering firm building custom platforms, cloud infrastructure, AI agents, and system integrations for companies from growth stage to enterprise.",
        "slogan": "Software that holds up at scale.",
        "image": "https://lambertttech.com/og-image.png?v=2",
        "logo": "https://lambertttech.com/brand/logo-horizontal.svg",
        "founder": {
          "@type": "Person",
          "name": "Angel Lambertt",
          "url": "https://alambertt.dev"
        },
        "sameAs": ["https://alambertt.dev"],
        "knowsAbout": [
          "Custom software development",
          "Cloud architecture",
          "AWS",
          "Infrastructure as code",
          "System integration",
          "API development",
          "AI agents",
          "Legacy modernization",
          "IoT platforms",
          "Performance engineering"
        ],
        "currenciesAccepted": "USD",
        "areaServed": { "@type": "Country", "name": "United States" },
        "serviceType": "Custom Software Development",
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Software Engineering Services",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom platform development" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cloud and infrastructure engineering" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "APIs and system integration" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI agents and automation" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Data and IoT platforms" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Performance and legacy modernization" } }
          ]
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://lambertttech.com/#website",
        "url": "https://lambertttech.com/",
        "name": "Lambertt Tech",
        "description": "Software engineering firm building custom platforms, cloud infrastructure, and system integrations.",
        "publisher": { "@id": "https://lambertttech.com/#business" },
        "inLanguage": "en-US"
      }
    ]
  }
</script>
<link
  rel='dns-prefetch'
  href='https://images.pexels.com'
/>
<!-- Self-hosted font preload (speeds up LCP text render) -->
<link
  rel='preload'
  href='/fonts/geist-latin-var.woff2'
  as='font'
  type='font/woff2'
  crossorigin
/>
