---
import { ico } from '../../lib/icons';

const faqs = [
  {
    q: 'How much does a website cost?',
    a: 'Most one-page local business websites fall between $300 and $800. Larger multi-page sites or full refreshes typically run $800 to $2,000. You get a fixed quote before any work starts — no surprises.',
  },
  {
    q: 'What areas do you serve?',
    a: 'I\'m based in Jupiter, Florida and work with local businesses across Palm Beach County — including Palm Beach Gardens, Tequesta, Wellington, West Palm Beach, Boca Raton, and Delray Beach. In-person meetings are easy to arrange.',
  },
  {
    q: 'How long does it take to build a website?',
    a: 'A typical one-page site goes live in one to two weeks once I have your content. Larger projects take a bit longer depending on the number of pages and integrations.',
  },
  {
    q: 'What\'s included in the free mockup?',
    a: 'You get a real one-page design direction built specifically for your business — not a template or a slideshow. You see the actual look and structure before spending anything, with no obligation.',
  },
  {
    q: 'Will my website work well on phones?',
    a: 'Yes. Every site is mobile-first, so it loads fast and looks right on phones, tablets, and desktops. Most of your customers will find you on their phone, so that comes first.',
  },
  {
    q: 'Do you help my business show up on Google?',
    a: 'Yes. Every site ships with local SEO basics — page titles, meta descriptions, structured data, and Google Business Profile setup — so nearby customers can find you when they search.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section
  id='faq'
  class='px-5 sm:px-8 py-20 md:py-28'
  style='background-color: var(--color-surface-2);'
  aria-labelledby='faq-heading'
>
  <div class='mx-auto max-w-3xl'>
    <div class='text-center'>
      <p
        class='text-xs font-bold tracking-widest uppercase'
        style='color: var(--color-brand-blue);'
      >
        FAQ
      </p>
      <h2
        id='faq-heading'
        class='mt-3 text-3xl font-bold tracking-tight sm:text-4xl'
        style='color: var(--color-brand-dark);'
      >
        Common questions
      </h2>
      <p
        class='mt-3 text-base leading-relaxed'
        style='color: var(--color-text-secondary);'
      >
        Everything local business owners usually ask before getting started.
      </p>
    </div>

    <div class='mt-10 space-y-3'>
      {
        faqs.map(f => (
          <details
            class='group rounded-2xl border'
            style='border-color: var(--color-border); background-color: var(--color-surface);'
          >
            <summary
              class='flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-base font-semibold sm:px-6'
              style='color: var(--color-brand-dark);'
            >
              {f.q}
              <span
                class='shrink-0 transition-transform duration-200 group-open:rotate-45'
                style='color: var(--color-brand-blue);'
                set:html={ico('plus')}
              />
            </summary>
            <p
              class='px-5 pb-5 text-sm leading-relaxed sm:px-6'
              style='color: var(--color-text-secondary);'
            >
              {f.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script
  type='application/ld+json'
  is:inline
  set:html={JSON.stringify(faqJsonLd)}
/>
