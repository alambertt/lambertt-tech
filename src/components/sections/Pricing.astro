---
import { ico } from '../../lib/icons';

const factors = [
  'System complexity',
  'Existing codebase and stack',
  'Integrations required',
  'Compliance and security needs',
  'Cloud footprint',
  'Timeline and team overlap',
];

const tiers = [
  {
    featured: false,
    title: 'Discovery & architecture review',
    detail:
      'A short, fixed-scope engagement that ends in a written technical plan: architecture, risks, sequencing, and cost. Useful on its own, and it de-risks everything after it.',
    price: 'Fixed fee',
  },
  {
    featured: true,
    title: 'Project delivery',
    detail:
      'A defined system built and shipped end to end against an agreed scope, with milestones you approve as they land.',
    price: 'Fixed scope',
  },
  {
    featured: false,
    title: 'Embedded engineering',
    detail:
      'Senior capacity inside your team on a monthly basis — your roadmap, your standups, your repository. Best when the work is ongoing rather than a single deliverable.',
    price: 'Monthly retainer',
  },
];
---

<section
  id='engagement'
  class='px-5 py-20 sm:px-8 lg:px-10'
  style='background-color: var(--color-background);'
>
  <div class='mx-auto max-w-6xl'>
    <div class='grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start'>
      <div class='lg:sticky lg:top-24'>
        <p
          class='mb-3 text-[11px] font-bold uppercase tracking-[0.24em]'
          style='color: var(--color-brand-blue);'
        >
          Engagement
        </p>
        <h2
          class='text-4xl font-bold tracking-[-0.055em] sm:text-5xl'
          style='color: var(--color-brand-dark);'
        >
          Three ways to work together.
        </h2>
        <p
          class='mt-5 max-w-md text-base leading-7'
          style='color: var(--color-text-secondary);'
        >
          Which one fits depends on how well defined the work already is. Most companies start with discovery and
          decide from there.
        </p>
        <div
          class='mt-7 inline-flex items-center gap-3 rounded-full border px-5 py-3'
          style='border-color: var(--color-border); background-color: var(--color-surface); box-shadow: 0 1px 4px rgba(var(--color-black-rgb),0.04);'
        >
          <span
            style='color: var(--color-brand-blue);'
            set:html={ico('shield')}
          />
          <p
            class='text-sm font-semibold'
            style='color: var(--color-brand-dark);'
          >
            Scope and cost agreed before work starts
          </p>
        </div>
      </div>

      <div class='space-y-4'>
        {
          tiers.map(tier => (
            <div
              class='rounded-3xl border p-5 sm:p-6'
              style={
                tier.featured
                  ? 'border-color: rgba(var(--color-blue-rgb),0.25); background: linear-gradient(135deg, var(--color-brand-soft), var(--color-surface)); box-shadow: 0 12px 28px -10px rgba(var(--color-blue-rgb),0.20);'
                  : 'border-color: var(--color-border); background-color: var(--color-surface);'
              }
            >
              <div class='flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'>
                <div>
                  <h3
                    class='text-base font-semibold tracking-[-0.01em]'
                    style='color: var(--color-text-primary);'
                  >
                    {tier.title}
                  </h3>
                  <p
                    class='mt-1 max-w-xl text-sm leading-6'
                    style='color: var(--color-text-secondary);'
                  >
                    {tier.detail}
                  </p>
                </div>
                <div class='shrink-0 text-left sm:text-right'>
                  <p
                    class='text-[11px] font-medium uppercase tracking-[0.16em]'
                    style='color: var(--color-text-secondary);'
                  >
                    Engagement model
                  </p>
                  <p
                    class='mt-1 text-lg font-bold tracking-[-0.02em] whitespace-nowrap'
                    style='color: var(--color-brand-dark);'
                  >
                    {tier.price}
                  </p>
                </div>
              </div>
            </div>
          ))
        }

        <!-- What affects the price -->
        <div
          class='rounded-3xl border p-6'
          style='border-color: var(--color-border); background-color: var(--color-surface);'
        >
          <div class='flex items-start gap-4'>
            <div
              class='grid h-11 w-11 shrink-0 place-items-center rounded-full'
              style='background-color: var(--color-brand-soft); color: var(--color-brand-blue);'
              set:html={ico('clock')}
            />
            <div>
              <h3
                class='text-base font-semibold'
                style='color: var(--color-text-primary);'
              >
                What shapes the estimate
              </h3>
              <p
                class='mt-2 text-sm leading-6'
                style='color: var(--color-text-secondary);'
              >
                Pricing follows the shape of the system, not a rate card. These are the variables that move it most,
                and all of them get settled during discovery.
              </p>
            </div>
          </div>
          <div class='mt-6 flex flex-wrap gap-2.5'>
            {
              factors.map(f => (
                <span
                  class='inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium'
                  style='border-color: var(--color-border); background-color: var(--color-surface); color: var(--color-brand-dark); box-shadow: 0 1px 2px rgba(var(--color-black-rgb),0.04);'
                >
                  <span
                    style='color: var(--color-accent-teal);'
                    set:html={ico('check-sm')}
                  />
                  {f}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
