---
import { ico } from '../../lib/icons';

type Project = {
  /** Industry / domain — shown as eyebrow text */
  sector: string;
  /** Client or product name */
  client: string;
  /** Our role on the engagement */
  role: string;
  /** What we built, in one or two sentences */
  summary: string;
  /** Up to 4 short stack tags */
  tags: string[];
  /** Public URL, when the work is something visitors can open */
  href?: string;
};

const projects: Project[] = [
  {
    sector: 'Enterprise ERP',
    client: 'Argus Enterprises Serv Group',
    role: 'Senior Software Engineer',
    summary:
      'Two enterprise ERP platforms built and deployed on AWS, with infrastructure defined as code and serverless services behind the internal tooling their teams use daily.',
    tags: ['TypeScript', 'AWS CDK', 'Serverless', 'IaC'],
  },
  {
    sector: 'Medical diagnostics',
    client: 'Targeted Bioscience',
    role: 'Senior Software Engineer',
    summary:
      'Diagnostic workflow tooling for lab teams, including an image processing pipeline and Python services exposed through a REST API.',
    tags: ['Python', 'FastAPI', 'Image processing', 'REST'],
  },
  {
    sector: 'Recruiting platform',
    client: 'SkillMil',
    role: 'Senior Software Developer',
    summary:
      'Full-stack delivery on a workforce platform, including AI chatbot agents running in production to guide candidates through matching and applications.',
    tags: ['React', 'Node.js', 'AI agents'],
  },
  {
    sector: 'Performance testing SaaS',
    client: 'Relampo',
    role: 'Cofounder',
    summary:
      'A load testing product built from scratch: a CLI engine written in Go that runs YAML-defined scenarios, plus the SaaS platform around it.',
    tags: ['Go', 'CLI', 'SaaS', 'Distributed'],
  },
  {
    sector: 'Smart home technology',
    client: 'Digital Lifestyle Designs',
    role: 'Design and build',
    summary: 'Multi-page marketing site with a full service catalog and contact flow.',
    tags: ['Next.js', 'Tailwind'],
    href: 'https://www.digitallifestyledesigns.com',
  },
];
---

<section
  id='work'
  class='px-5 sm:px-8 py-20 md:py-28'
  style='background-color: var(--color-background);'
  aria-labelledby='work-heading'
>
  <div class='mx-auto max-w-6xl'>
    <div class='flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between'>
      <div class='max-w-xl'>
        <p
          class='text-xs font-bold tracking-widest uppercase'
          style='color: var(--color-brand-blue);'
        >
          Selected work
        </p>
        <h2
          id='work-heading'
          class='mt-3 text-3xl font-bold tracking-tight sm:text-4xl'
          style='color: var(--color-brand-dark);'
        >
          Systems already running in production
        </h2>
        <p
          class='mt-3 text-base leading-relaxed'
          style='color: var(--color-text-secondary);'
        >
          Every engagement below was scoped, built, and shipped end to end — not prototyped and handed off.
        </p>
      </div>
      <a
        href='#contact'
        class='shrink-0 inline-flex items-center gap-2 rounded-full border px-6 py-2.5 text-sm font-semibold transition-all duration-200 hover:-translate-y-px min-h-[44px]'
        style='border-color: var(--color-border); color: var(--color-brand-dark); background-color: var(--color-surface);'
      >
        Discuss your project <span set:html={ico('arrow-right')} />
      </a>
    </div>

    <div class='mt-12 grid gap-6 sm:grid-cols-2'>
      {
        projects.map(p => {
          const Wrapper = p.href ? 'a' : 'div';
          const wrapperProps = p.href
            ? {
                href: p.href,
                target: '_blank',
                rel: 'noopener noreferrer',
                'aria-label': `View live site: ${p.client}`,
              }
            : {};
          return (
            <Wrapper
              class={`group relative flex flex-col overflow-hidden rounded-3xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${p.href ? 'cursor-pointer' : ''}`}
              style='border-color: var(--color-border); background-color: var(--color-surface); box-shadow: 0 2px 8px 0 rgba(var(--color-black-rgb),0.05);'
              {...wrapperProps}
            >
              <div
                class='absolute top-0 left-0 right-0 h-0.5 opacity-0 transition-opacity duration-300 group-hover:opacity-100'
                style='background-color: var(--color-brand-blue);'
              />

              <div
                class='relative overflow-hidden px-6 py-7'
                style='background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-brand-blue) 100%);'
              >
                <div
                  class='pointer-events-none absolute inset-0'
                  style='background-image: radial-gradient(circle, rgba(var(--color-white-rgb),0.5) 1px, transparent 1px); background-size: 22px 22px; opacity: 0.12;'
                  aria-hidden='true'
                />
                <p
                  class='relative text-[10px] font-bold uppercase tracking-[0.2em]'
                  style='color: rgba(var(--color-white-rgb),0.75);'
                >
                  {p.sector}
                </p>
                <p class='relative mt-1.5 text-xl font-bold leading-tight text-white'>{p.client}</p>
              </div>

              <div class='flex flex-1 flex-col px-5 pb-5 pt-4'>
                <div class='flex items-start justify-between gap-3'>
                  <div class='min-w-0'>
                    <p
                      class='text-base font-semibold leading-snug'
                      style='color: var(--color-brand-dark);'
                    >
                      {p.role}
                    </p>
                  </div>
                  {p.href && (
                    <span
                      class='shrink-0 mt-0.5 inline-flex items-center gap-1 rounded-full px-3 py-1 text-[11px] font-semibold'
                      style='background-color: var(--color-brand-soft); color: var(--color-brand-blue); border: 1px solid rgba(var(--color-blue-rgb),0.18);'
                    >
                      Visit
                      <span set:html={ico('arrow-right')} />
                    </span>
                  )}
                </div>

                <p
                  class='mt-2.5 text-sm leading-relaxed'
                  style='color: var(--color-text-secondary);'
                >
                  {p.summary}
                </p>

                <div class='mt-4 flex flex-wrap gap-2 pt-1'>
                  {p.tags.map(t => (
                    <span
                      class='inline-flex items-center rounded-full px-3 py-1 text-[11px] font-semibold'
                      style='background-color: var(--color-brand-soft); color: var(--color-brand-blue);'
                    >
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </Wrapper>
          );
        })
      }
    </div>
  </div>
</section>
